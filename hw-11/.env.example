# Скопируйте в hw-11/.env и заполните. Файл .env в git не попадает (hw-11/.gitignore).
# Секреты (пароли/токены) лучше держать в macOS Keychain — см. README.MD, раздел «Секреты и env».

# Пароль admin в Grafana.
# Keychain: security add-generic-password -a fastrapier -s grafana-hw11 -w '<password>' -U
GRAFANA_ADMIN_PASSWORD=

# SMTP-сервер: host:port. Gmail — smtp.gmail.com:587, Яндекс — smtp.yandex.ru:587
# false — проверка правил без писем; true — полная SMTP-проверка по заданию.
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.gmail.com:587

# Логин SMTP (обычно полный адрес почты)
GRAFANA_SMTP_USER=

# Пароль приложения (SMTP-токен), НЕ основной пароль от аккаунта.
# Keychain: security add-generic-password -a fastrapier -s smtp-hw11 -w '<token>' -U
GRAFANA_SMTP_PASSWORD=

# Адрес в поле From письма. По умолчанию берётся GRAFANA_SMTP_USER.
GRAFANA_SMTP_FROM_ADDRESS=

# Куда Grafana отправляет алерты (contact point). По умолчанию GRAFANA_SMTP_USER.
ALERT_EMAIL=
